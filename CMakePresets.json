{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "linux",
            "displayName": "Linux (Stack + RpcEndpoint)",
            "binaryDir": "${sourceDir}/build/linux",
            "cacheVariables": {
                "PROFINET_POSIX": "ON"
            },
            "inherits": "base"
        },
        {
            "name": "portable",
            "displayName": "Portable (codecs + Dispatcher, no OS I/O)",
            "binaryDir": "${sourceDir}/build/portable",
            "cacheVariables": {
                "PROFINET_POSIX": "OFF"
            },
            "inherits": "base"
        },
        {
            "name": "windows",
            "displayName": "Windows (Winsock RPC + optional Npcap examples)",
            "binaryDir": "${sourceDir}/build/windows",
            "cacheVariables": {
                "PROFINET_POSIX": "OFF",
                "PROFINET_BUILD_TESTS": "OFF",
                "PROFINET_BUILD_EXAMPLES": "ON"
            },
            "inherits": "base"
        }
    ],
    "buildPresets": [
        {
            "name": "linux",
            "configurePreset": "linux"
        },
        {
            "name": "portable",
            "configurePreset": "portable"
        },
        {
            "name": "windows",
            "configurePreset": "windows"
        }
    ],
    "testPresets": [
        {
            "name": "linux",
            "configurePreset": "linux",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "portable",
            "configurePreset": "portable",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows",
            "configurePreset": "windows",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
