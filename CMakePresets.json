{
    "version": 3,
    "cmakeMinimumRequired": {"major": 3, "minor": 21, "patch": 0},
    "configurePresets": [
        {
            "name": "linux",
            "displayName": "Linux (Stack + RpcEndpoint)",
            "binaryDir": "${sourceDir}/build/linux",
            "cacheVariables": {"PROFINET_POSIX": "ON"}
        },
        {
            "name": "portable",
            "displayName": "Portable (codecs + Dispatcher, no OS I/O)",
            "binaryDir": "${sourceDir}/build/portable",
            "cacheVariables": {"PROFINET_POSIX": "OFF"}
        }
    ],
    "buildPresets": [
        {"name": "linux", "configurePreset": "linux"},
        {"name": "portable", "configurePreset": "portable"}
    ],
    "testPresets": [
        {"name": "linux", "configurePreset": "linux", "output": {"outputOnFailure": true}},
        {"name": "portable", "configurePreset": "portable", "output": {"outputOnFailure": true}}
    ]
}
